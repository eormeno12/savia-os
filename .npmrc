shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true
# Don't auto-purge/reinstall node_modules before each script run. Avoids the
# "Aborted removal of modules directory due to no TTY" failure (e.g. after a
# `pnpm deploy --prod` leaves the store marked production). Resync manually with
# `pnpm install` when manifests change.
verify-deps-before-run=false
