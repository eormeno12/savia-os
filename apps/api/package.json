{
  "name": "@savia-os/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "worker:dev": "nest start --watch --entryFile worker",
    "mcp:dev": "nest start --watch --entryFile mcp",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:mcp": "node dist/mcp.js",
    "engine:bootstrap": "node dist/scripts/engine-bootstrap.main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "TEST_E2E=1 jest --runInBand",
    "clean": "rm -rf dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/client-ses": "^3.1073.0",
    "@aws-sdk/s3-presigned-post": "^3.1073.0",
    "@aws-sdk/s3-request-presigner": "^3.1073.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6",
    "@qdrant/js-client-rest": "^1",
    "@savia-os/contracts": "workspace:*",
    "argon2": "^0.44.0",
    "bullmq": "^5.79.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "ioredis": "^5",
    "jose": "^6.2.3",
    "mammoth": "^1.12.0",
    "mem0ai": "^3.1.0",
    "mercadopago": "^3.1.0",
    "ml-kmeans": "^7.0.1",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^4",
    "openai": "^4.104.0",
    "pdf-parse": "^2.4.5",
    "pino-http": "^11.0.0",
    "redis": "^6.0.0",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@nestjs/cli": "^11",
    "@nestjs/schematics": "^11",
    "@nestjs/testing": "^11.1.27",
    "@savia-os/tsconfig": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.6.0",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.4.2",
    "prisma": "^6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.61.1"
  }
}
