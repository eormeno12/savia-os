{
  "name": "savia-os",
  "version": "0.0.0",
  "private": true,
  "description": "Savia OS — product monorepo",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "turbo build",
    "predev": "node scripts/free-ports.mjs legacy-api legacy-app landing demo-api",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "clean": "turbo clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + 2>/dev/null; true",
    "prelanding:dev": "node scripts/free-ports.mjs landing",
    "landing:dev": "turbo dev --filter=@savia-os/landing",
    "landing:build": "turbo build --filter=@savia-os/landing",
    "landing:lint": "turbo lint --filter=@savia-os/landing",
    "landing:typecheck": "turbo typecheck --filter=@savia-os/landing",
    "generate:og": "node scripts/generate-og.mjs",
    "predemo-api:dev": "node scripts/free-ports.mjs demo-api",
    "demo-api:dev": "pnpm --filter @savia-os/demo-api dev",
    "prelegacy-api:dev": "node scripts/free-ports.mjs legacy-api",
    "legacy-api:dev": "turbo dev --filter=@savia-os/legacy-api",
    "prelegacy-worker:dev": "node scripts/free-ports.mjs legacy-worker",
    "legacy-worker:dev": "pnpm --filter @savia-os/legacy-api worker:dev",
    "prelegacy-mcp:dev": "node scripts/free-ports.mjs legacy-mcp",
    "legacy-mcp:dev": "pnpm --filter @savia-os/legacy-api mcp:dev",
    "prelegacy-app:dev": "node scripts/free-ports.mjs legacy-app",
    "legacy-app:dev": "turbo dev --filter=@savia-os/legacy-app",
    "legacy-db:migrate": "pnpm --filter @savia-os/legacy-api db:migrate",
    "legacy-db:deploy": "pnpm --filter @savia-os/legacy-api db:deploy",
    "predev:stack": "node scripts/free-ports.mjs legacy-api legacy-worker legacy-mcp legacy-app",
    "dev:stack": "node scripts/dev-stack.mjs",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "stack:up": "docker compose -f infra/docker-compose.yml --profile full up -d --build",
    "stack:down": "docker compose -f infra/docker-compose.yml --profile full down",
    "stack:logs": "docker compose -f infra/docker-compose.yml --profile full logs -f"
  },
  "devDependencies": {
    "puppeteer-core": "^23.0.0",
    "turbo": "^2.5.4"
  }
}
